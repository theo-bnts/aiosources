# Docker Compose: use fresh v2 volumes for the first deployment.
POSTGRES_DB=aiosources
POSTGRES_USER=aiosources
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
AIOSOURCES_IMAGE=ghcr.io/theo-bnts/aiosources:stable
PORT=7000
BIND_IP=127.0.0.1
ADMIN_PASSWORD=
PUBLIC_URL=
# Optional alternative volume names, chosen before first launch:
# POSTGRES_VOLUME=aiosources_v2_postgres_data
# STATE_VOLUME=aiosources_v2_state

# Native or external-database deployment:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aiosources
# BIND=127.0.0.1:7000
# DATA_DIR=.ingest
# PROVIDERS_DIR=providers
# Provider keys, TMDB, AllDebrid, TorBox and passkeys belong in the encrypted Secrets page.
# Preserve the state volume (vault.key) together with the PostgreSQL database.
